# ─────────────────────────────────────────────────────────────────────────────
# Pylon QC — environment
#
# Only five things live here: the ones needed BEFORE the app can show you a UI.
# Everything else — Pylon token, Slack, Vertex project and models, the daily
# schedule — is managed in Admin and stored encrypted in the database.
#
# On Railway, set these as service variables.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Encrypts everything stored through the Admin UI and signs session cookies.
#    Generate once and keep it — a new key signs everyone out and orphans the
#    stored credentials. Required on any hosted deployment, where a generated
#    key file would be wiped on the next deploy.
#      python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QC_MASTER_KEY=

# 2 & 3. Google sign-in. Environment-only because they are needed before anyone
#    can reach the Admin UI. Create a Web application OAuth client whose
#    redirect URI is exactly  <app-url>/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 4. Who gets admin, comma-separated. Reapplied at every sign-in.
#    Without this, whoever signs in first becomes admin.
QC_ADMIN_EMAILS=you@spotdraft.com

# 5. Where the database file lives. Needed on a container platform because the
#    UI is stored *in* the database and so cannot tell the app where to find it.
#    Railway: add a volume mounted at /data, then set /data/qc.db
#    Leave blank when running locally.
QC_DB_PATH=

# ── everything below is optional ─────────────────────────────────────────────

# Public URL. Auto-detected from RAILWAY_PUBLIC_DOMAIN, so set it only for a
# custom domain. Must match the OAuth redirect URI you registered.
QC_BASE_URL=

QC_ALLOWED_DOMAIN=spotdraft.com
QC_SESSION_HOURS=12
# Auto-enabled when the base URL is https. Override only if you must.
QC_COOKIE_SECURE=
QC_LOG_LEVEL=INFO
